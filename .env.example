# Copy this file to .env (never committed). All values are optional.
# Set ONE of the two keys below to let Claude write application letters.

# Option 1: Anthropic directly. Key from https://platform.claude.com/settings/keys (starts with sk-ant-)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5

# Option 2: OpenRouter. Key from https://openrouter.ai/settings/keys (starts with sk-or-)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-opus-5.5

# Port of the local server (default 8787) and folder for personal data (default data/).
# PORT=8787
# DATA_DIR=data
