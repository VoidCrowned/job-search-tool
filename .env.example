# Copy this file to .env (never committed). All values are optional.

# Lets Claude write application letters. Get a key at https://platform.claude.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Model for letters (default: claude-opus-5-5, about 8 cents per letter).
# ANTHROPIC_MODEL=claude-opus-5-5

# Port of the local server (default 8787) and folder for personal data (default data/).
# PORT=8787
# DATA_DIR=data
