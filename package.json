{
  "name": "job-search-tool",
  "version": "0.1.0",
  "description": "Local job search for the Bundesagentur für Arbeit Jobsuche API",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "api:check": "tsx scripts/api-check.ts",
    "letter:check": "tsx scripts/letter-check.ts",
    "relay:dev": "tsx scripts/relay-dev.ts",
    "relay:check": "tsx scripts/relay-check.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VoidCrowned/job-search-tool.git"
  },
  "license": "WTFPL",
  "type": "module",
  "bugs": {
    "url": "https://github.com/VoidCrowned/job-search-tool/issues"
  },
  "homepage": "https://github.com/VoidCrowned/job-search-tool#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@hono/node-server": "^2.1.11",
    "dompurify": "^3.5.0",
    "hono": "^4.13.21",
    "marked": "^18.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
